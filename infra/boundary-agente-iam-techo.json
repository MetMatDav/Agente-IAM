{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AlcanceDelSistema",
      "Effect": "Allow",
      "Action": [
        "s3:*",
        "dynamodb:*",
        "sqs:*",
        "sns:*",
        "logs:*",
        "cloudwatch:*",
        "ec2:Describe*",
        "lambda:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AutoservicioMinimoDelUsuario",
      "Effect": "Allow",
      "Action": [
        "iam:ChangePassword",
        "iam:GetUser",
        "iam:GetAccountPasswordPolicy",
        "iam:ListMFADevices",
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GemelaDeAccionesProhibidasDelCodigo",
      "Effect": "Deny",
      "Action": [
        "lambda:UpdateFunctionCode",
        "lambda:AddPermission",
        "lambda:UpdateFunctionConfiguration",
        "ec2:ModifyInstanceAttribute",
        "ec2:DescribeInstanceAttribute",
        "ec2:DescribeLaunchTemplateVersions",
        "ec2:DescribeSpotFleetRequests",
        "ec2:DescribeSpotInstanceRequests",
        "ec2:DescribeVerifiedAccessTrustProviders",
        "ec2:DescribeVpnConnections",
        "ec2:DescribeConversionTasks",
        "ec2:DescribeImportImageTasks",
        "ec2:DescribeImportSnapshotTasks",
        "ec2:DescribeBundleTasks"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SinGestionDePermisos",
      "Effect": "Deny",
      "Action": [
        "s3:AssociateAccessGrantsIdentityCenter",
        "s3:BypassGovernanceRetention",
        "s3:CreateAccessGrant",
        "s3:CreateAccessGrantsInstance",
        "s3:CreateAccessGrantsLocation",
        "s3:DeleteAccessGrant",
        "s3:DeleteAccessGrantsInstance",
        "s3:DeleteAccessGrantsInstanceResourcePolicy",
        "s3:DeleteAccessGrantsLocation",
        "s3:DeleteAccessPointPolicy",
        "s3:DeleteAccessPointPolicyForObjectLambda",
        "s3:DeleteBucketPolicy",
        "s3:DissociateAccessGrantsIdentityCenter",
        "s3:ObjectOwnerOverrideToBucketOwner",
        "s3:PutAccessGrantsInstanceResourcePolicy",
        "s3:PutAccessPointPolicy",
        "s3:PutAccessPointPolicyForObjectLambda",
        "s3:PutAccessPointPublicAccessBlock",
        "s3:PutAccountPublicAccessBlock",
        "s3:PutBucketAcl",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutMultiRegionAccessPointPolicy",
        "s3:PutObjectAcl",
        "s3:PutObjectVersionAcl",
        "s3:UpdateAccessGrantsLocation",
        "dynamodb:DeleteResourcePolicy",
        "dynamodb:PutResourcePolicy",
        "dynamodb:UpdateAbacStatus",
        "sqs:AddPermission",
        "sqs:RemovePermission",
        "sqs:SetQueueAttributes",
        "sns:AddPermission",
        "sns:RemovePermission",
        "sns:SetTopicAttributes",
        "logs:DeleteResourcePolicy",
        "logs:PutResourcePolicy",
        "cloudwatch:AssumeAccessProfile",
        "cloudwatch:CreateAccessGrant",
        "cloudwatch:CreateAccessProfile",
        "cloudwatch:CreateDomainAccessGrantForOrganization",
        "cloudwatch:DeleteAccessGrant",
        "cloudwatch:DeleteAccessProfile",
        "cloudwatch:DeleteDomainAccessGrantForOrganization",
        "cloudwatch:UpdateAccessProfile",
        "lambda:AddLayerVersionPermission",
        "lambda:DeleteResourcePolicy",
        "lambda:DisableReplication",
        "lambda:EnableReplication",
        "lambda:PutResourcePolicy",
        "lambda:RemoveLayerVersionPermission",
        "lambda:RemovePermission"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SinEscriturasDeAlcanceDeCuenta",
      "Effect": "Deny",
      "Action": [
        "s3:CreateJob",
        "s3:CreateStorageLensGroup",
        "s3:PutStorageLensConfiguration",
        "dynamodb:InjectError",
        "dynamodb:PurchaseReservedCapacityOfferings",
        "sns:CreatePlatform*",
        "sns:CreateSMSSandboxPhoneNumber",
        "sns:DeleteEndpoint",
        "sns:DeletePlatformApplication",
        "sns:DeleteSMSSandboxPhoneNumber",
        "sns:OptInPhoneNumber",
        "sns:SetEndpointAttributes",
        "sns:SetPlatformApplicationAttributes",
        "sns:SetSMSAttributes",
        "sns:VerifySMSSandboxPhoneNumber",
        "logs:AssociateSourceToS3TableIntegration",
        "logs:CallWithBearerToken",
        "logs:Cancel*",
        "logs:CreateImportTask",
        "logs:CreateLogDelivery",
        "logs:DeleteAccountPolicy",
        "logs:DeleteIndexPolicy",
        "logs:DeleteIntegration",
        "logs:DeleteLogDelivery",
        "logs:DeletePipelineRule",
        "logs:DeleteQueryDefinition",
        "logs:DisassociateSourceFromS3TableIntegration",
        "logs:Link",
        "logs:PutAccountPolicy",
        "logs:PutIndexPolicy",
        "logs:PutIntegration",
        "logs:PutPipelineRule",
        "logs:PutQueryDefinition",
        "logs:PutStorageTierPolicy",
        "logs:UpdateLogDelivery",
        "cloudwatch:CallWithBearerToken",
        "cloudwatch:Create*",
        "cloudwatch:DeleteAnomalyDetector",
        "cloudwatch:DeleteOmniThread",
        "cloudwatch:DeleteResourceMetricsConfiguration",
        "cloudwatch:EnableTopologyDiscovery",
        "cloudwatch:InvokeIntegration",
        "cloudwatch:Link",
        "cloudwatch:PutAnomalyDetector",
        "cloudwatch:PutIntelligenceConfiguration",
        "cloudwatch:PutManagedInsightRules",
        "cloudwatch:PutRecords",
        "cloudwatch:QueryTraces",
        "cloudwatch:SearchPrincipals",
        "cloudwatch:StartO*",
        "cloudwatch:StartTelemetry*",
        "cloudwatch:StopOTelEnrichment",
        "cloudwatch:StopTelemetry*",
        "cloudwatch:Submit*",
        "cloudwatch:UpdateOTelEnrichment",
        "cloudwatch:UpdateOmniThread",
        "cloudwatch:UpdatePreferences",
        "cloudwatch:UpdateResourceMetricsConfiguration",
        "lambda:ConnectMicrovm",
        "lambda:CreateCodeSigningConfig",
        "lambda:CreateEventSourceMapping",
        "lambda:CreateMicrovmImage",
        "lambda:PassNetworkConnector"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NadaSobreLosRecursosDelSistema",
      "Effect": "Deny",
      "Action": "*",
      "Resource": [
        "arn:aws:s3:::agente-iam-*",
        "arn:aws:dynamodb:*:*:table/agente-iam-*",
        "arn:aws:sqs:*:*:agente-iam-*",
        "arn:aws:sns:*:*:agente-iam-*",
        "arn:aws:lambda:*:*:function:agente-iam-*",
        "arn:aws:logs:*:*:log-group:/aws/bedrock-agentcore/runtimes/agente_iam*",
        "arn:aws:logs:*:*:log-group:/aws/lambda/agente-iam-*",
        "arn:aws:logs:*:*:log-group:agente-iam-*",
        "arn:aws:cloudwatch:*:*:alarm:agente-iam-*"
      ]
    },
    {
      "Sid": "NiLosDisparadoresDelSistema",
      "Effect": "Deny",
      "Action": [
        "lambda:CreateEventSourceMapping",
        "lambda:DeleteEventSourceMapping",
        "lambda:GetEventSourceMapping",
        "lambda:UpdateEventSourceMapping"
      ],
      "Resource": "*",
      "Condition": {
        "ArnLike": {
          "lambda:FunctionArn": "arn:aws:lambda:*:*:function:agente-iam-*"
        }
      }
    },
    {
      "Sid": "SoloRecursosDeLaPropiaCuenta",
      "Effect": "Deny",
      "Action": [
        "s3:*",
        "dynamodb:*",
        "sqs:*",
        "sns:*",
        "logs:*",
        "cloudwatch:*",
        "ec2:*",
        "lambda:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEqualsIfExists": {
          "aws:ResourceAccount": "${aws:PrincipalAccount}"
        }
      }
    }
  ]
}
