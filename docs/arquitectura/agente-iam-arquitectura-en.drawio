<mxCell id="b5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="920" y="504" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="b6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1190" y="1205" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="b7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1388" y="476" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="b8" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1270" y="440" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="b9" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="132" y="160" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="bF" value="F" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D13212;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1526" y="650" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="leyenda-fondo" value="" style="html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="2260" y="30" width="640" height="1390" as="geometry" /></mxCell>
<mxCell id="leyenda-titulo" value="&lt;b&gt;Legend: the path step by step&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2280" y="46" width="600" height="24" as="geometry" /></mxCell>
<mxCell id="ley-1-badge" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2280" y="88" width="38" height="36" as="geometry" /></mxCell>
<mxCell id="ley-1-texto" value="&lt;b&gt;Opens the page&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The browser loads the static page from CloudFront. The bucket is private: only CloudFront can read it (OAC).&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2332" y="86" width="550" height="100" as="geometry" /></mxCell>
<mxCell id="ley-2-badge" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2280" y="192" width="38" height="36" as="geometry" /></mxCell>
<mxCell id="ley-2-texto" value="&lt;b&gt;Signs in&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Cognito redirects to Identity Center over SAML; the person signs in with MFA and comes back with an access_token and an id_token (PKCE).&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2332" y="190" width="550" height="100" as="geometry" /></mxCell>
<mxCell id="ley-3-badge" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2280" y="296" width="38" height="36" as="geometry" /></mxCell>
<mxCell id="ley-3-texto" value="&lt;b&gt;Requests access&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The form goes to the AgentCore runtime with the access_token. The JWT authorizer validates it; the person comes from the token, not from the form.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2332" y="294" width="550" height="100" as="geometry" /></mxCell>
<mxCell id="ley-4-badge" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2280" y="400" width="38" height="36" as="geometry" /></mxCell>
<mxCell id="ley-4-texto" value="&lt;b&gt;The agent proposes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Pre-checks, the model in Bedrock and three validation layers (deny list, Access Analyzer, simulator). The agent cannot write to IAM.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2332" y="398" width="550" height="100" as="geometry" /></mxCell>
<mxCell id="ley-5-badge" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2280" y="504" width="38" height="36" as="geometry" /></mxCell>
<mxCell id="ley-5-texto" value="&lt;b&gt;It is recorded&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The runtime writes the row to DynamoDB with state 'propuesta' (proposed).&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2332" y="502" width="550" height="100" as="geometry" /></mxCell>
<mxCell id="ley-6-badge" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2280" y="608" width="38" height="36" as="geometry" /></mxCell>
<mxCell id="ley-6-texto" value="&lt;b&gt;A human approves&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The approver signs in with their permission set and signs the request to the Lambda URL. The Lambda reads who signed, keeps people separate, revalidates and writes 'aprobada' (approved).&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2332" y="606" width="550" height="100" as="geometry" /></mxCell>
<mxCell id="ley-7-badge" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2280" y="712" width="38" height="36" as="geometry" /></mxCell>
<mxCell id="ley-7-texto" value="&lt;b&gt;It is applied&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The stream triggers the applier, which creates the person's role with Techo as its boundary, trust only for their sub, and an expiry; writes 'aplicada' (applied).&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2332" y="710" width="550" height="100" as="geometry" /></mxCell>
<mxCell id="ley-8-badge" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2280" y="816" width="38" height="36" as="geometry" /></mxCell>
<mxCell id="ley-8-texto" value="&lt;b&gt;The person is notified&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Every final state triggers the notices Lambda, which sends the id, the state and, when applied, the role and its expiry through SES.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2332" y="814" width="550" height="100" as="geometry" /></mxCell>
<mxCell id="ley-9-badge" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2280" y="920" width="38" height="36" as="geometry" /></mxCell>
<mxCell id="ley-9-texto" value="&lt;b&gt;Uses the access&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;The page exchanges the id_token in STS for the role's credentials, which expire after the hours requested.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2332" y="918" width="550" height="100" as="geometry" /></mxCell>
<mxCell id="ley-F-badge" value="F" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D13212;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2280" y="1024" width="38" height="36" as="geometry" /></mxCell>
<mxCell id="ley-F-texto" value="&lt;b&gt;If the applier fails&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;Three attempts; the event goes to the queue, the alarm fires and SNS emails the operator.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2332" y="1022" width="550" height="100" as="geometry" /></mxCell>
<mxCell id="ley-lineas" value="&lt;b&gt;Lines&lt;/b&gt;&lt;br&gt;Solid: a call or a write, in the direction of the arrow.&lt;br&gt;&lt;font color=&quot;#D13212&quot;&gt;Red dashed: failure path.&lt;/font&gt;&lt;br&gt;Pink border: AWS accounts. Dashed teal border: region.&lt;br&gt;Left out: the package bucket, the deployment role and the Operador and Lectura permission sets." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2280" y="1132" width="600" height="130" as="geometry" /></mxCell>
</root></mxGraphModel></diagram>
</mxfile>
