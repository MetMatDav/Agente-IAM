<diagram name="1 Context" id="contexto"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2800" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" />
<mxCell id="p1-title" value="Agente IAM: context" style="text;html=1;align=left;verticalAlign=top;fontSize=30;fontStyle=1;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#F2F2F2);" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="42" as="geometry" /></mxCell>
<mxCell id="p1-subtitle" value="Who uses the system and which systems it talks to (C4 model, level 1). State as measured on 2026-10-26." style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontFamily=Helvetica;fontColor=light-dark(#545B64,#CCCCCC);whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="44" y="72" width="1500" height="26" as="geometry" /></mxCell>
<mxCell id="p1-sep" value="" style="line;strokeWidth=2;html=1;strokeColor=#FF9900;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="44" y="102" width="1500" height="10" as="geometry" /></mxCell>
<mxCell id="c-solicitante" value="&lt;b&gt;Requester&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Person]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Asks for temporary access to an AWS resource from the web page.&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="220" height="130" as="geometry" /></mxCell>
<mxCell id="c-aprobador" value="&lt;b&gt;Approver&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Person]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Reviews the proposal and approves or rejects it. Never the person who asked.&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="220" height="130" as="geometry" /></mxCell>
<mxCell id="c-operador" value="&lt;b&gt;Operator&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[Person]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Deploys the stacks and receives the alarms.&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="220" height="130" as="geometry" /></mxCell>
<mxCell id="c-agente" value="&lt;b&gt;Agente IAM&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[System]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Reads the request, proposes the least-privilege policy, validates it and, after human approval, creates a role that expires.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="420" width="320" height="190" as="geometry" /></mxCell>
<mxCell id="c-idc" value="&lt;b&gt;IAM Identity Center&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[External system]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Who each person is, with MFA, and which group they belong to.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1240" y="160" width="260" height="150" as="geometry" /></mxCell>
<mxCell id="c-bedrock" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[External system]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;The model that drafts the proposal (Claude).&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1240" y="380" width="260" height="150" as="geometry" /></mxCell>
<mxCell id="c-iam" value="&lt;b&gt;AWS IAM&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[External system]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Where the proposal is validated and the person's role is created.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1240" y="600" width="260" height="150" as="geometry" /></mxCell>
<mxCell id="c-correo" value="&lt;b&gt;Email (Amazon SES)&lt;/b&gt;&lt;div style=&quot;font-size:11px&quot;&gt;[External system]&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px&quot;&gt;Tells the person about each decision.&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1240" y="820" width="260" height="150" as="geometry" /></mxCell>
