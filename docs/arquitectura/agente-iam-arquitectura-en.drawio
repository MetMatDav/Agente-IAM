<mxCell id="r3-lbl" value="Deploys and monitors&lt;br&gt;[CloudFormation, email]" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];labelBackgroundColor=light-dark(#FFFFFF,#1E1E1E);fontSize=11;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" connectable="0" parent="r3"><mxGeometry x="-0.3" y="0" relative="1" as="geometry"><mxPoint x="0" y="0" as="offset" /></mxGeometry></mxCell>
