<mxCell id="b3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="250" y="516" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="b4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="868" y="580" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="b5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="920" y="504" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="b6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1190" y="1205" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="b7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1388" y="476" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="b8" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1270" y="440" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="b9" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="132" y="160" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="bF" value="F" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D13212;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=15;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1526" y="650" width="28" height="28" as="geometry"/></mxCell>
<mxCell id="leyenda-fondo" value="" style="html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="2260" y="30" width="640" height="1390" as="geometry"/></mxCell>
<mxCell id="leyenda-titulo" value="&lt;b&gt;Leyenda: el recorrido paso a paso&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=18;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2280" y="46" width="600" height="24" as="geometry"/></mxCell>
<mxCell id="ley-1-badge" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2280" y="88" width="38" height="36" as="geometry"/></mxCell>
<mxCell id="ley-1-texto" value='&lt;b&gt;Abre la pagina&lt;/b&gt;&lt;br&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;El navegador descarga la pagina estatica de CloudFront. El bucket es privado: solo CloudFront lo lee (OAC).&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2332" y="86" width="550" height="100" as="geometry"/></mxCell>
<mxCell id="ley-2-badge" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2280" y="192" width="38" height="36" as="geometry"/></mxCell>
<mxCell id="ley-2-texto" value='&lt;b&gt;Inicia sesion&lt;/b&gt;&lt;br&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;Cognito redirige a Identity Center por SAML; la persona entra con MFA y vuelve con un access_token y un id_token (PKCE).&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2332" y="190" width="550" height="100" as="geometry"/></mxCell>
<mxCell id="ley-3-badge" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2280" y="296" width="38" height="36" as="geometry"/></mxCell>
<mxCell id="ley-3-texto" value='&lt;b&gt;Pide el acceso&lt;/b&gt;&lt;br&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;El formulario va al runtime de AgentCore con el access_token. El autorizador JWT lo valida; la persona sale del token, no del formulario.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2332" y="294" width="550" height="100" as="geometry"/></mxCell>
<mxCell id="ley-4-badge" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2280" y="400" width="38" height="36" as="geometry"/></mxCell>
<mxCell id="ley-4-texto" value='&lt;b&gt;El agente propone&lt;/b&gt;&lt;br&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;Chequeos previos, modelo en Bedrock y tres capas de validacion (lista negra, Access Analyzer, simulador). El agente no tiene escritura en IAM.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2332" y="398" width="550" height="100" as="geometry"/></mxCell>
<mxCell id="ley-5-badge" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2280" y="504" width="38" height="36" as="geometry"/></mxCell>
<mxCell id="ley-5-texto" value="&lt;b&gt;Queda registrada&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;El runtime escribe la fila en DynamoDB con estado 'propuesta'.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2332" y="502" width="550" height="100" as="geometry"/></mxCell>
<mxCell id="ley-6-badge" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2280" y="608" width="38" height="36" as="geometry"/></mxCell>
<mxCell id="ley-6-texto" value="&lt;b&gt;Un humano aprueba&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;El aprobador entra con su permission set y firma la peticion a la URL de la Lambda. La Lambda lee quien firma, separa personas, revalida y escribe 'aprobada'.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2332" y="606" width="550" height="100" as="geometry"/></mxCell>
<mxCell id="ley-7-badge" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2280" y="712" width="38" height="36" as="geometry"/></mxCell>
<mxCell id="ley-7-texto" value="&lt;b&gt;Se aplica&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;El stream dispara al aplicador, que crea el rol de la persona con el Techo como boundary, confianza solo para su sub y caducidad; escribe 'aplicada'.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2332" y="710" width="550" height="100" as="geometry"/></mxCell>
<mxCell id="ley-8-badge" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2280" y="816" width="38" height="36" as="geometry"/></mxCell>
<mxCell id="ley-8-texto" value='&lt;b&gt;Se avisa&lt;/b&gt;&lt;br&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;Cada estado final dispara la Lambda de avisos, que manda por SES el id, el estado y, si aplica, el rol y el vencimiento.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2332" y="814" width="550" height="100" as="geometry"/></mxCell>
<mxCell id="ley-9-badge" value="9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2280" y="920" width="38" height="36" as="geometry"/></mxCell>
<mxCell id="ley-9-texto" value='&lt;b&gt;Usa el acceso&lt;/b&gt;&lt;br&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;La pagina canjea el id_token en STS por credenciales del rol, que caducan a las horas pedidas.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2332" y="918" width="550" height="100" as="geometry"/></mxCell>
<mxCell id="ley-F-badge" value="F" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D13212;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=20;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2280" y="1024" width="38" height="36" as="geometry"/></mxCell>
<mxCell id="ley-F-texto" value='&lt;b&gt;Si el aplicador falla&lt;/b&gt;&lt;br&gt;&lt;span style="color: light-dark(rgb(0,0,0), rgb(255,255,255));"&gt;Tres intentos; el evento va a la cola, la alarma salta y SNS avisa al operador por correo.&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2332" y="1022" width="550" height="100" as="geometry"/></mxCell>
<mxCell id="ley-lineas" value='&lt;b&gt;Lineas&lt;/b&gt;&lt;br&gt;Continua: llamada o escritura, en el sentido de la flecha.&lt;br&gt;&lt;font color="#D13212"&gt;Discontinua roja: camino de fallo.&lt;/font&gt;&lt;br&gt;Cajas con borde rosa: cuentas de AWS. Borde turquesa discontinuo: region.&lt;br&gt;Fuera del dibujo: el bucket de paquetes, el rol de despliegue y los permission sets Operador y Lectura.' style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=light-dark(#232F3E,#E6E6E6);fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2280" y="1132" width="600" height="130" as="geometry"/></mxCell>
</root></mxGraphModel></diagram>
</mxfile>
