<mxCell id="p1-title" value="Agente IAM: contexto" style="text;html=1;align=left;verticalAlign=top;fontSize=30;fontStyle=1;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#F2F2F2);" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1500" height="42" as="geometry"/></mxCell>
<mxCell id="p1-subtitle" value="Quien usa el sistema y con que sistemas habla (modelo C4, nivel 1). Estado medido el 26-10-2026." style="text;html=1;align=left;verticalAlign=top;fontSize=16;fontFamily=Helvetica;fontColor=light-dark(#545B64,#CCCCCC);whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="44" y="72" width="1500" height="26" as="geometry"/></mxCell>
<mxCell id="p1-sep" value="" style="line;strokeWidth=2;html=1;strokeColor=#FF9900;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="44" y="102" width="1500" height="10" as="geometry"/></mxCell>
<mxCell id="c-solicitante" value='&lt;b&gt;Persona solicitante&lt;/b&gt;&lt;div style="font-size:11px"&gt;[Persona]&lt;/div&gt;&lt;div style="font-size:12px;margin-top:6px"&gt;Pide un acceso temporal a un recurso de AWS desde la pagina web.&lt;/div&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="220" height="130" as="geometry"/></mxCell>
<mxCell id="c-aprobador" value='&lt;b&gt;Aprobador&lt;/b&gt;&lt;div style="font-size:11px"&gt;[Persona]&lt;/div&gt;&lt;div style="font-size:12px;margin-top:6px"&gt;Revisa la propuesta y la aprueba o la rechaza. Nunca es quien pide.&lt;/div&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="220" height="130" as="geometry"/></mxCell>
<mxCell id="c-operador" value='&lt;b&gt;Operador&lt;/b&gt;&lt;div style="font-size:11px"&gt;[Persona]&lt;/div&gt;&lt;div style="font-size:12px;margin-top:6px"&gt;Despliega las pilas y recibe las alarmas.&lt;/div&gt;' style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="220" height="130" as="geometry"/></mxCell>
<mxCell id="c-agente" value='&lt;b&gt;Agente IAM&lt;/b&gt;&lt;div style="font-size:11px"&gt;[Sistema]&lt;/div&gt;&lt;div style="font-size:12px;margin-top:6px"&gt;Interpreta la solicitud, propone la politica minima, la valida y, tras la aprobacion humana, crea un rol con caducidad.&lt;/div&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="620" y="420" width="320" height="190" as="geometry"/></mxCell>
<mxCell id="c-idc" value='&lt;b&gt;IAM Identity Center&lt;/b&gt;&lt;div style="font-size:11px"&gt;[Sistema externo]&lt;/div&gt;&lt;div style="font-size:12px;margin-top:6px"&gt;Quien es cada persona, con MFA, y a que grupo pertenece.&lt;/div&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1240" y="160" width="260" height="150" as="geometry"/></mxCell>
<mxCell id="c-bedrock" value='&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;div style="font-size:11px"&gt;[Sistema externo]&lt;/div&gt;&lt;div style="font-size:12px;margin-top:6px"&gt;El modelo que redacta la propuesta (Claude).&lt;/div&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1240" y="380" width="260" height="150" as="geometry"/></mxCell>
<mxCell id="c-iam" value='&lt;b&gt;AWS IAM&lt;/b&gt;&lt;div style="font-size:11px"&gt;[Sistema externo]&lt;/div&gt;&lt;div style="font-size:12px;margin-top:6px"&gt;Donde se valida la propuesta y donde se crea el rol de la persona.&lt;/div&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1240" y="600" width="260" height="150" as="geometry"/></mxCell>
<mxCell id="c-correo" value='&lt;b&gt;Correo (Amazon SES)&lt;/b&gt;&lt;div style="font-size:11px"&gt;[Sistema externo]&lt;/div&gt;&lt;div style="font-size:12px;margin-top:6px"&gt;Avisa a la persona de cada decision.&lt;/div&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1240" y="820" width="260" height="150" as="geometry"/></mxCell>
